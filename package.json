{
  "name": "dsh-miloco",
  "version": "0.1.1",
  "description": "DeepSeek Harness 插件：基于本机 miloco-cli 的小米米家设备工具与本地控制面板（第三方集成，非小米官方）",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "ui",
    "cordis.patch.yml",
    "README.md",
    "NOTICE",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "miloco",
    "xiaomi",
    "mijia",
    "smart-home"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "homepage": "https://github.com/Lzm1645/dsh-miloco#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lzm1645/dsh-miloco.git"
  },
  "bugs": {
    "url": "https://github.com/Lzm1645/dsh-miloco/issues"
  }
}